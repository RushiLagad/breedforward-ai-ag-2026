# Hackathon data is confidential. Nothing from the dataset gets committed.
data/
*.csv
*.tsv
*.parquet
*.xlsx
*.zip
*.Rdata
!data/.gitkeep
# small result summaries are versioned; raw results/ are not
!results_summary/*.csv
Hackathon2026/

# Results and figures are regenerated, not versioned
results/
outputs/
figures/*.png
figures/*.pdf
!figures/.gitkeep

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
venv/
.venv/
.env
.env.*
!.env.example
*.pem
*.key
*.joblib
*.pkl

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

!figures/fig_*.png
