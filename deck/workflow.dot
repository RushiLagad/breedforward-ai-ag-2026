// BreedForward pipeline. Render: dot -Tpng -Gdpi=200 deck/workflow.dot -o deck/workflow.png
digraph BreedForward {
  graph [rankdir=TB, fontname="Helvetica", bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.45, splines=spline];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#C9D2CC", fillcolor="white", fontcolor="#1B2230", margin="0.18,0.10"];
  edge  [color="#64707A", arrowsize=0.8, penwidth=1.2];

  ph  [label=<<b>C1/C2 phenotypes</b><br/><font point-size="10" color="#64707A">1.07M plots, 8 traits</font>>];
  mk  [label=<<b>2,911 SNP markers</b><br/><font point-size="10" color="#64707A">one shared panel</font>>];
  env [label=<<b>Environment data</b><br/><font point-size="10" color="#64707A">1,185 year x location, 84 covariates</font>>];
  tab [label=<<b>One clean table</b><br/><font point-size="10" color="#64707A">1.02M plots · 154,551 lines · 998 families</font>>];
  cen [label=<<b>Line values centred within environment x tester</b><br/><font point-size="10" color="#64707A">GCA; tester effects removed; training plots only</font>>];
  gxe [label=<<b>G x E test: between-regime r = within-regime reliability</b><br/><font point-size="10" color="#64707A">no re-ranking, so predict broad-acre</font>>];
  hist[label=<<b>Historical-only marker model</b><br/><font point-size="10" color="#64707A">ridge, 2001–2007 · r 0.14 · baseline and fallback</font>>];
  sib [label=<<b>Sparse 2008 sibling evidence</b><br/><font point-size="10" color="#64707A">a share of EVERY family phenotyped (stratified)</font>>];
  cur [label=<<b>Sampling curve</b><br/><font point-size="10" color="#64707A">plots spent vs realised gain</font>>];
  two [label=<<b>Two-stage prediction</b><br/><font point-size="10" color="#64707A">family mean + within-family markers · r 0.36</font>>];
  idx [label=<<b>Weighted advancement index → ranked candidates</b><br/><font point-size="10" color="#2E6B3A">scored against the real 2008 season, which no model saw</font>>];

  {rank=same; ph; mk; env}
  {rank=same; hist; sib}
  {rank=same; two; cur}
  ph -> tab; env -> tab; tab -> cen; cen -> gxe;
  gxe -> hist; gxe -> sib; sib -> cur; sib -> two;
  hist -> two [style=dashed, label=<<font point-size="9" color="#64707A"> fallback / baseline</font>>];
  two -> idx;
  mk -> hist [color="#C9A227", style=dashed, penwidth=1.4];
  mk -> two  [color="#C9A227", style=dashed, penwidth=1.4, label=<<font point-size="9" color="#C9A227"> genotypes, never environment-adjusted</font>>];
}
